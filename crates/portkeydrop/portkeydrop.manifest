<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      type="win32"
      name="Orinks.PortkeyDrop"
      version="1.0.0.0"
      processorArchitecture="*"/>
  <description>Portkey Drop, a keyboard-first file transfer client.</description>

  <!--
    Common Controls 6 is not optional for a wxWidgets application. Without this
    dependency Windows loads comctl32 5.82 from System32, which does not export
    GetWindowSubclass, and the process fails to start with
    STATUS_ENTRYPOINT_NOT_FOUND before main() ever runs. It is also what gives
    the app themed, correctly-sized native controls.
  -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
          type="win32"
          name="Microsoft.Windows.Common-Controls"
          version="6.0.0.0"
          processorArchitecture="*"
          publicKeyToken="6595b64144ccf1df"
          language="*"/>
    </dependentAssembly>
  </dependency>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        Per-monitor DPI awareness keeps text crisp on mixed-DPI setups. Screen
        magnifier users in particular end up on scaled displays, where a
        DPI-unaware window is rendered blurry by the system.
      -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor, System</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">True/PM</dpiAware>
      <!-- Use UTF-8 for the ANSI code page, so paths with non-ASCII names work. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1. -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
    </application>
  </compatibility>
</assembly>
