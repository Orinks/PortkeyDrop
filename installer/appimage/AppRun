#!/bin/bash
# AppImage entry point. The executable and the Prism speech library live
# together in usr/bin; libprism.so finds its own bundled dependencies through
# a RUNPATH of $ORIGIN, so no library path juggling is needed for those.
HERE="$(dirname "$(readlink -f "$0")")"
export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$HERE/usr/bin/PortkeyDrop" "$@"
